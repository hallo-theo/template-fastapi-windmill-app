# Copy to `.env.general` and fill in the actual values.
# `.env.general` is gitignored.

# Shared between the FastAPI auth middleware and the Vite dev proxy.
# Generate one with: openssl rand -hex 32
FRONTEND_SERVICE_SECRET=

# (Optional) Cross-origin allowlist. Comma-separated.
# Falls back to http://localhost:5173 when unset.
ALLOWED_ORIGINS=
